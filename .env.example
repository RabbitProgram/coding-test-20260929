# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ホスト側に公開するポート
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# マーカー指定（DEMO_MAP_ID は開発用）
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# 逆ジオコーディング用
GOOGLE_MAPS_SERVER_API_KEY=
# キャッシュを残す秒数
GEOCODE_CACHE_TTL_SECONDS=2592000
