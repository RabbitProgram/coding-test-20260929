{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "description": "バックエンドが起動していれば `{ \"status\": \"ok\" }` を返す。DB の接続状態までは確認しない。",
        "operationId": "AppController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "起動している",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponseDto"
                }
              }
            }
          }
        },
        "summary": "起動確認",
        "tags": [
          "Status"
        ]
      }
    },
    "/spots": {
      "get": {
        "description": "登録されているすべてのスポットを、id の昇順で返す。絞り込みやページングは未対応（常に全件）。",
        "operationId": "SpotsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "スポットの配列",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpotResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "スポット一覧の取得",
        "tags": [
          "Spots"
        ]
      }
    }
  },
  "info": {
    "title": "位置情報探索アプリ API",
    "description": "コーディングテスト用",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StatusResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "起動していれば常に \"ok\""
          }
        },
        "required": [
          "status"
        ]
      },
      "SpotResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "スポット ID（bigint のため文字列で返す）"
          },
          "name": {
            "type": "string",
            "example": "東京タワー",
            "description": "スポット名"
          },
          "category": {
            "type": "string",
            "example": "観光名所",
            "description": "カテゴリ（観光名所、公園、寺院など）"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "東京都港区",
            "description": "住所。未登録の場合は null"
          },
          "lat": {
            "type": "number",
            "example": 35.658581,
            "description": "緯度（WGS84）"
          },
          "lng": {
            "type": "number",
            "example": 139.745433,
            "description": "経度（WGS84）"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "address",
          "lat",
          "lng"
        ]
      }
    }
  }
}
