{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "description": "バックエンドが起動していれば `{ \"status\": \"ok\" }` を返す。DB の接続状態までは確認しない。",
        "operationId": "AppController_getStatus",
        "parameters": [],
        "responses": {
          "200": {
            "description": "起動している",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponseDto"
                }
              }
            }
          }
        },
        "summary": "起動確認",
        "tags": [
          "Status"
        ]
      }
    },
    "/spots": {
      "get": {
        "description": "登録されているスポットを返す。lat・lng・radius を指定すると、中心から radius メートル以内のスポットだけを、近い順に（distance つきで）返す。指定しない場合は、id の昇順で全件を返す。",
        "operationId": "SpotsController_findAll",
        "parameters": [
          {
            "name": "lat",
            "required": false,
            "in": "query",
            "description": "中心の緯度（WGS84）。lng と radius とセットで指定する",
            "schema": {
              "example": 35.681236,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": false,
            "in": "query",
            "description": "中心の経度（WGS84）。lat と radius とセットで指定する",
            "schema": {
              "example": 139.767125,
              "type": "number"
            }
          },
          {
            "name": "radius",
            "required": false,
            "in": "query",
            "description": "中心からの距離（メートル）。0 より大きく 1000000 以下。lat と lng とセットで指定する",
            "schema": {
              "example": 5000,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "スポットの配列",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpotResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "lat・lng・radius の一部だけの指定、または範囲外の値"
          }
        },
        "summary": "スポット一覧の取得",
        "tags": [
          "Spots"
        ]
      }
    }
  },
  "info": {
    "title": "位置情報探索アプリ API",
    "description": "コーディングテスト用",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "StatusResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "起動していれば常に \"ok\""
          }
        },
        "required": [
          "status"
        ]
      },
      "SpotResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1",
            "description": "スポット ID（bigint のため文字列で返す）"
          },
          "name": {
            "type": "string",
            "example": "東京タワー",
            "description": "スポット名"
          },
          "category": {
            "type": "string",
            "example": "観光名所",
            "description": "カテゴリ（観光名所、公園、寺院など）"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "東京都港区",
            "description": "住所。未登録の場合は null"
          },
          "lat": {
            "type": "number",
            "example": 35.658581,
            "description": "緯度（WGS84）"
          },
          "lng": {
            "type": "number",
            "example": 139.745433,
            "description": "経度（WGS84）"
          },
          "distance": {
            "type": "number",
            "example": 1234.5,
            "description": "中心からの距離（メートル）。lat / lng / radius で絞り込んだときだけ返す"
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "address",
          "lat",
          "lng"
        ]
      }
    }
  }
}
